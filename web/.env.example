# Copy to .env.local and adjust (never commit it).
# The API (npm run dev in api/) listens on 8080.
VITE_API_URL=http://localhost:8080
# Only needed when the API runs with STAFF_TOKEN set (approve, reject, close, /demo/reset).
VITE_STAFF_TOKEN=
# Settlement token label. The testnet issues TUSD; Rob's mocks say RLUSD.
VITE_TOKEN_LABEL=TUSD
# 1 = render every screen from src/fixtures/ with no API.
VITE_MOCK=
# Public XRPL testnet node used to read ledger index and fee by tx hash.
VITE_XRPL_WS=wss://s.altnet.rippletest.net:51233
