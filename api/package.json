{
  "name": "settle-api",
  "version": "0.1.0",
  "private": true,
  "description": "Settle backend: tab state machine, fake POS, grace timer, settlement agent, manager approval, metrics and live events.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "DEMO=1 tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:json": "tsx scripts/export-seed.ts",
    "test:coverage": "vitest run --coverage",
    "test:agent": "python3 -m pytest -q -p no:cacheprovider agent/tests"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1149.0",
    "@fastify/cors": "11.3.1",
    "ethers": "6.17.0",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
