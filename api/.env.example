# Local development. Copy to .env and adjust (never commit .env).
PORT=8080
# DEMO=1 shortens the grace timer to 10 s and seeds the wireframe data.
DEMO=1
# stub = fake hashes after LEDGER_STUB_DELAY_MS; module = import Alex's ledger/ (reads its own .env keys)
LEDGER_MODE=stub
LEDGER_MODULE=../ledger/index.js
LEDGER_STUB_DELAY_MS=3000
# stub only: replay these real testnet hashes when the file exists (explorer links resolve)
LEDGER_FIXTURE=../ledger/fixtures/happy-path.json
SEED_LIVE_ESCROWS=0
# local = deterministic fallback; agentcore = call the deployed settlement agent
AGENT_MODE=local
AGENT_RUNTIME_ARN=
AGENT_QUALIFIER=live
AGENT_TIMEOUT_MS=8000
AWS_REGION=us-east-1
CORS_ORIGIN=*
# Shared staff secret: approve, reject, close, PATCH /policy, fund and /demo/reset need it as the
# X-Staff-Token header. Leave empty for local dev (those routes are open; the server warns at boot).
STAFF_TOKEN=

# Mastercard integration --------------------------------------------------------
# LEDGER_MODE=ap4m settles over Mastercard Agent Pay for Machines (XRPL EVM Testnet).
AP4M_NETWORK=simulated            # simulated | live
INTENT_MODE=off                   # on = Verifiable Intent mandates per tab (off for the demo)
AP4M_USD_PER_RLUSD=100            # demo scaling: 20 RLUSD hackathon budget, so $100 = 1 RLUSD
AP4M_SIM_BUDGET_RLUSD=20
PUBLIC_BASE_URL=http://127.0.0.1:8080
# live only (from the AP4M participant portal; never commit real values)
AP4M_API_URL=https://hackathon.ap4m.build
AP4M_TEAM_NAME=
AP4M_AGENT_PRIVATE_KEY=
AP4M_MERCHANT_SUBMITTER_KEY=
AP4M_MERCHANT_ID=
AP4M_MERCHANT_PAYOUT=
