# Copy to .env, or run `npm run setup:accounts` to generate it with fresh faucet-funded testnet accounts.
# Seeds stay inside ledger/; nothing else in the repo should read them.
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
# Only setup:token and demo:reset use the issuer key. Leave it out of any deployment.
ISSUER_SEED=
VENUE_SEED=
MEMBER_1_SEED=
MEMBER_2_SEED=
MEMBER_3_SEED=
MEMBER_4_SEED=
MEMBER_5_SEED=
